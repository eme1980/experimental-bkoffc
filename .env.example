# =============================================================================
# Experimental Backoffice - variables de entorno
# Copia este archivo a `.env` y rellena los valores.
#
# Estas variables se leen directamente de process.env en el servidor Node.
# INSFORGE_URL, INSFORGE_KEY y APP_URL son OBLIGATORIAS para el API (excepto
# APP_URL, que tiene un fallback en desarrollo).
# =============================================================================

# --- Obligatorias: conexión con InsForge (BaaS) ------------------------------
# Base URL del proyecto InsForge (backend de autenticación, BD y email).
INSFORGE_URL=https://tu-proyecto.insforge.app
# Anon/API key pública del proyecto InsForge.
INSFORGE_KEY=tu-anon-key

# --- Opcional ---
# Puerto HTTP del servidor. Por defecto: 3000.
PORT=3000
# Nivel mínimo de logging (debug | info | warn | error). Por defecto: info.
# Útil para activar trazas de debug en desarrollo o silenciar log en producción.
LOG_LEVEL=info
# URL base del frontend usada para construir el enlace de "restablecer contraseña".
# Se usa en el email de recuperación (POST /auth/reset-password-request).
APP_URL=http://localhost:5173