{
  "name": "experimental-bkoffc",
  "version": "1.0.0",
  "type": "module",
  "description": "TDD Authentication System",
  "main": "src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@insforge/sdk": "^1.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^1.0.0"
  }
}
